# TANGLE Expansion Intelligence - Environment Configuration Example
# Copy this file to .env and configure your values

# Backend Configuration
BACKEND_PORT=3000
NODE_ENV=development

# Database Configuration (Optional - required for persistence)
DATABASE_URL=postgresql://user:password@localhost:5432/tangle

# Qloo API Configuration (Required for live mode)
# Hackathon API Configuration
QLOO_API_KEY=your_qloo_api_key_here
QLOO_BASE_URL=https://hackathon.api.qloo.com

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_TTL_SECONDS=3600
